# Copiar a .env (no se versiona) y reemplazar cada change-me por un valor local.
# Uso: docker compose --env-file .env -f infra/docker-compose.yml up -d
POSTGRES_PASSWORD=change-me
RABBITMQ_USER=change-me
RABBITMQ_PASSWORD=change-me
REDIS_PASSWORD=change-me
# Puertos del host (opcionales). Cambiarlos si ya están ocupados.
#POSTGRES_PORT=5432
#RABBITMQ_PORT=5672
#RABBITMQ_MANAGEMENT_PORT=15672
#REDIS_PORT=6379

# Transmisión al SRI. Vacío: no se envía nada (los comprobantes quedan firmados). 1: ambiente de
# pruebas. 1,2: pruebas y producción (solo después de certificar).
#SRI_ENABLED_ENVIRONMENTS=
# Tiempos de espera y reintentos ante el SRI (valores por defecto).
#SRI_CONNECT_TIMEOUT=10s
#SRI_READ_TIMEOUT=60s
#SRI_AUTHORIZATION_DELAY=3s
#SRI_RETRY_BACKOFF=15s
#SRI_RETRY_MAX=40
# false: esta instancia solo atiende la API y no procesa comprobantes en segundo plano.
#EINVOICE_WORKER_ENABLED=true

# Entrega de comprobantes por correo. Apagada por defecto. Para habilitarla hacen falta el
# remitente y un servidor SMTP.
#DELIVERY_EMAIL_ENABLED=false
#DELIVERY_EMAIL_FROM=facturas@example.com
#SPRING_MAIL_HOST=localhost
#SPRING_MAIL_PORT=1025
# La conexión exige STARTTLS. false solo para un servidor de desarrollo local sin TLS.
#SMTP_STARTTLS=true
#SPRING_MAIL_USERNAME=change-me
#SPRING_MAIL_PASSWORD=change-me

# Proveedor OIDC de desarrollo (Keycloak, perfil "idp" del compose). Solo para trabajar en local.
#   docker compose --env-file .env -f infra/docker-compose.yml --profile idp up -d
# KEYCLOAK_DEMO_PASSWORD es la contraseña del usuario "demo" con el que se entra a la aplicación.
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DEMO_PASSWORD=change-me
#KEYCLOAK_PORT=8081

# Métricas para Prometheus en /actuator/prometheus. Sin ficha, no existen. Al menos 24 caracteres
# aleatorios; el recolector la envía como "Authorization: Bearer <ficha>".
#EINVOICE_METRICS_TOKEN=

# Tope de peticiones por usuario y minuto (todas, y las que cambian datos). Valores por defecto.
#EINVOICE_RATE_LIMIT_REQUESTS=1200
#EINVOICE_RATE_LIMIT_WRITES=300
# Cuánto se espera a Redis antes de dejar pasar la petición sin contarla.
#REDIS_TIMEOUT=500ms

# Conexión de la API a PostgreSQL y a Redis cuando corre fuera de los contenedores (spring-boot:run),
# una variable cada una, con las contraseñas de arriba. Caracteres especiales codificados (%40 = @).
#DATABASE_URL=postgresql://app:change-me@localhost:5432/einvoice
#REDIS_URL=redis://:change-me@localhost:6379

# La aplicación completa en contenedores (infra/docker-compose.stack.yml): además de lo anterior.
# Clave maestra que cifra los certificados (32 bytes en Base64: openssl rand -base64 32).
#EINVOICE_MASTER_KEY=
# Proveedor de identidad: la misma dirección para el navegador y para los contenedores.
#OIDC_ISSUER=
#OIDC_AUDIENCE=einvoice-api
#OIDC_CLIENT_ID=einvoice-web
# Al menos 32 caracteres aleatorios: cifra las cookies de sesión de la web.
#SESSION_SECRET=
# Dirección pública de la web (https fuera de esta máquina) y puerto en el que se publica aquí.
#APP_BASE_URL=http://localhost:3000
#WEB_PORT=3000

# Avisos a los sistemas de los clientes (webhooks). Apagados por defecto: encenderlos es aceptar que
# el worker llame a direcciones https públicas que escriben los clientes. El mismo valor para la API
# y para el worker.
#EINVOICE_WEBHOOKS_ENABLED=false

# Invitaciones a una empresa. Solo si el proveedor de identidad no incluye el correo del usuario en
# el token de acceso: con true basta el enlace para aceptar, y vale para cualquiera que lo tenga.
#EINVOICE_INVITATIONS_ALLOW_WITHOUT_EMAIL=false
